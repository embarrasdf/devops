# Toolchain versions: the one place to change them.
#
# The kmp-toolchain image installs exactly these, and every consumer gets them
# from that image: cloud sessions (via cloud/setup.sh), cache images and CI jobs.
# After editing, merge to main; the "Build toolchain image" workflow rebuilds it.
#
# Not listed on purpose:
# - Gradle: each repo's wrapper picks its version, and the repo's cache image
#   carries that distribution.
# - Kotlin/Native, Node and other per-build downloads: they live in the cache images.
# - Chrome's system libraries: Ubuntu packages, installed by the Dockerfile.
#
# Lines with a "renovate:" comment are kept up to date by Renovate.

# Eclipse Temurin JDK, as an Adoptium release name.
# renovate: datasource=github-releases depName=adoptium/temurin17-binaries
JDK_RELEASE=jdk-17.0.20.1+1

# git-lfs (Paparazzi golden images live in LFS).
# renovate: datasource=github-releases depName=git-lfs/git-lfs extractVersion=^v(?<version>.*)$
GIT_LFS_VERSION=3.7.0

# Chrome for Testing's chrome-headless-shell, for Kotlin/Wasm and JS browser
# tests in CI container jobs (CHROME_BIN). Cloud sessions use their own Chromium.
# Versions: https://googlechromelabs.github.io/chrome-for-testing/
# renovate: datasource=custom.chrome-for-testing depName=chrome-headless-shell
CHROME_VERSION=155.0.8059.39

# Android SDK packages: one "<path under ANDROID_HOME> <archive name>" per line.
# Archive names are listed in https://dl.google.com/android/repository/repository2-3.xml
# Keep the platform for AndroidCompileSdk in gradle-plugins (currently 37) here,
# or AGP downloads it again in every session and image build.
ANDROID_SDK_PACKAGES="
platforms/android-35    platform-35_r02.zip
platforms/android-36    platform-36_r02.zip
platforms/android-37.0  platform-37.0_r02.zip
build-tools/35.0.0      build-tools_r35_linux.zip
build-tools/36.0.0      build-tools_r36_linux.zip
platform-tools          platform-tools_r35.0.2-linux.zip
"
