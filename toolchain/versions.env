# Toolchain versions: the one place to change them.
#
# The kmp-toolchain image installs exactly these, and every consumer gets them
# from that image: cloud sessions (via cloud/setup.sh) and workspace images.
# After editing, merge to main; the "Build toolchain image" workflow rebuilds it.
#
# Not listed on purpose:
# - Gradle: each repo's wrapper picks its version, and the workspace images
#   carry those distributions.
# - Kotlin/Native, Node and other per-build downloads: they live in the workspace images.
#
# Lines with a "renovate:" comment are kept up to date by Renovate.

# Eclipse Temurin JDK, as an Adoptium release name. CI uses the same major version
# (see actions/gradle-setup).
# renovate: datasource=github-releases depName=adoptium/temurin21-binaries
JDK_RELEASE=jdk-21.0.12.1+1

# git-lfs (Paparazzi golden images live in LFS).
# renovate: datasource=github-releases depName=git-lfs/git-lfs extractVersion=^v(?<version>.*)$
GIT_LFS_VERSION=3.7.0

# Android SDK command-line tools, which provide the SDK installer: the build
# number in the archive name, commandlinetools-linux-<build>_latest.zip, as
# listed in https://dl.google.com/android/repository/repository2-3.xml (23.0).
ANDROID_CMDLINE_TOOLS_BUILD=16111833

# Android SDK packages, as sdkmanager and `android sdk list` name them. The
# installer always installs the newest platform-tools, so that isn't pinned.
# Keep the platform for AndroidCompileSdk in gradle-plugins (currently 37) here,
# or AGP downloads it again in every session and image build.
ANDROID_SDK_PACKAGES="
platforms;android-37.0
build-tools;36.0.0
platform-tools
"
